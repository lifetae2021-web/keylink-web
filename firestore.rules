rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────
    // 헬퍼 함수
    // ─────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // 서버(Admin SDK)만 쓰는 필드: 클라이언트는 값을 새로 넣거나 바꿀 수 없고 지우는 것만 가능
    // (verifiedPhone: 문자 인증된 번호, mergedTo/mergedFrom: 휴대폰 인증으로 연결된 계정 표시)
    function serverOnlyFieldKept(field) {
      return request.resource.data.get(field, null) == null ||
        (resource != null && request.resource.data.get(field, null) == resource.data.get(field, null));
    }

    function serverOnlyFieldsKept() {
      return serverOnlyFieldKept('verifiedPhone') && serverOnlyFieldKept('phoneVerifiedAt') &&
        serverOnlyFieldKept('mergedTo') && serverOnlyFieldKept('mergedFrom');
    }

    function isSuperAdmin() {
      return isSignedIn() &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // ─────────────────────────────────────
    // users 컬렉션
    // ─────────────────────────────────────
    match /users/{userId} {
      // 본인·관리자만 읽기 (전화번호·생년월일 등 개인정보 보호)
      // 라인업·매칭 결과·투표처럼 다른 회원 정보가 필요한 화면은 서버 API(/api/sessions/[id]/...)가 필요한 항목만 준다
      allow read: if isUser(userId) || isAdmin();
      // v7.3.3: 신규 가입(create) 허용 - 본인 UID로 생성하되, role은 반드시 'user'여야 함
      // 포인트 잔액은 서버(Admin SDK)에서만 변경 - 본인이 생성/수정 시 points 필드를 넣거나 바꿀 수 없음
      allow create: if isUser(userId) && request.resource.data.role in ['user', 'guest'] &&
        !('points' in request.resource.data) && serverOnlyFieldsKept();
      // 기존 문서 수정: 관리자이거나, 본인일 때 (role 필드가 없거나 'user', 'guest'여야 함)
      // role은 본인이 올릴 수 없음: 기존 값 그대로(일반회원/VIP회원/제안 등 한글 등급 포함)이거나 user/guest일 때만 허용
      allow update: if isAdmin() || (isUser(userId) &&
        (request.resource.data.get('role', null) == resource.data.get('role', null) ||
         request.resource.data.get('role', 'user') in ['user', 'guest']) &&
        request.resource.data.get('points', 0) == resource.data.get('points', 0) &&
        serverOnlyFieldsKept());
      allow delete: if isSuperAdmin();

      // v8.15.9: 쿠폰 및 포인트 내역 서브 컬렉션 권한 추가
      match /coupons/{couponId} {
        allow read: if isUser(userId) || isAdmin();
        // 회원이 직접 만들 수 있는 건 가입 축하 쿠폰 1장뿐: 번호 'welcome' 고정, 5,000원, 미사용, 유효기간 약 3개월 이내
        // (그 외 쿠폰은 관리자 화면이나 서버(Admin SDK)가 발급)
        allow create: if isAdmin() || (isUser(userId) && couponId == 'welcome' &&
          request.resource.data.keys().hasOnly(['title', 'type', 'value', 'createdAt', 'expireAt', 'isUsed']) &&
          request.resource.data.title == '웰컴 가입 축하 쿠폰' &&
          request.resource.data.type == 'amount' &&
          request.resource.data.value == 5000 &&
          request.resource.data.isUsed == false &&
          request.resource.data.expireAt < request.time + duration.value(100, 'd'));
        // 회원은 '미사용 → 사용됨' 표시만 가능 (금액·유효기간 등은 못 바꿈)
        allow update: if isAdmin() || (isUser(userId) &&
          resource.data.isUsed == false && request.resource.data.isUsed == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedAt', 'usedInSession']));
        allow delete: if isAdmin();
      }
      match /pointHistory/{logId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if isAdmin();
      }
      // 관리자 전용 회원 메모 (본인에게도 비공개)
      match /adminNotes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // 관리자 알림의 포인트 적립 피드 (collectionGroup 조회)
    match /{path=**}/pointHistory/{logId} {
      allow read: if isAdmin();
    }

    // ─────────────────────────────────────
    // sessions (기수) 컬렉션
    // ─────────────────────────────────────
    match /sessions/{sessionId} {
      // ✅ v6.6.2: 비로그인 방문자도 읽기 가능 (홈페이지 신청 페이지 공개 노출)
      // 기수 목록은 공개 정보이므로 인증 불필요
      allow read: if true;
      // 관리자만 쓰기 가능 (기수 등록, 수정, 삭제)
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // applications (신청서) 컬렉션
    // ─────────────────────────────────────
    match /applications/{applicationId} {
      // 본인 신청서만 읽기 (다른 참가자 정보는 서버 API가 필요한 항목만 준다)
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // 관리자: 모든 신청서 읽기/쓰기
      allow read, write: if isAdmin();
      // 신규 신청: 본인 UID로만, 상태는 '신청됨'만, 호수·출석 같은 관리자용 값은 넣을 수 없다
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'applied') == 'applied' &&
        !('slotNumber' in request.resource.data) &&
        !('attended' in request.resource.data);
      // 비회원 신청서 → 회원 계정 이전은 서버(/api/applications/existing)가 문자 인증된 번호를 확인하고 처리한다
    }

    // ─────────────────────────────────────
    // votes (투표) 컬렉션
    // ─────────────────────────────────────
    match /votes/{voteId} {
      // 본인 투표만 읽기 가능
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      // 관리자: 모든 투표 읽기 (매칭 알고리즘용)
      allow read: if isAdmin();
      // 투표 제출: 본인 UID + 아직 제출하지 않은 경우에만 허용
      // (중복 방지는 복합 ID와 서버 로직으로 처리)
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // 투표 수정: 본인 투표만 수정 가능 (30분 타이머 제한은 클라이언트에서 처리)
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────
    // matchingResults (매칭 결과) 컬렉션 — legacy, 삭제 예정
    // ─────────────────────────────────────
    match /matchingResults/{resultId} {
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'approved';
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────
    // matchingSummaries (매칭 요약) 컬렉션
    // ─────────────────────────────────────
    match /matchingSummaries/{sessionId} {
      // 승인된 결과는 로그인한 사람만 읽기 (누가 누구와 매칭됐는지 담겨 있어 비로그인 공개 금지)
      // TODO: 그 기수 참가자만 읽게 하려면 참가자 uid 배열(participants)을 문서에 두는 구조 변경 필요
      allow read: if isSignedIn() && resource.data.status == 'approved';
      // 관리자: 모든 읽기/쓰기
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────
    // cms_notices (공지사항) 컬렉션
    // ─────────────────────────────────────
    match /cms_notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // cms_faqs (FAQ) 컬렉션
    // ─────────────────────────────────────
    match /cms_faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // cms_content (이용규정/약관/개인정보) 컬렉션
    // ─────────────────────────────────────
    match /cms_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_reviews/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // cms_partners (협업사) 컬렉션
    // ─────────────────────────────────────
    match /cms_partners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // smsTemplates (문자 템플릿) 컬렉션
    // ─────────────────────────────────────
    match /smsTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // settings (시스템 설정) 컬렉션
    // timer_scripts 등 관리자 전용 설정값
    // ─────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────
    // private_applications (1:1 매칭 신청) 컬렉션
    // ─────────────────────────────────────
    match /private_applications/{appId} {
      // 본인 신청서 읽기 가능
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // 신규 신청: 로그인한 유저가 본인 UID로 생성
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // 관리자: 모든 읽기/쓰기/업데이트
      allow read, write: if isAdmin();
      // 유저: 수락 액션을 위한 업데이트 (status가 profile_sent일 때만 negotiating으로 변경 허용)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid 
        && resource.data.status == 'profile_sent' 
        && request.resource.data.status == 'negotiating';
    }

    // ─────────────────────────────────────
    // visitor_logs (방문 기록) 컬렉션
    // ─────────────────────────────────────
    match /visitor_logs/{logId} {
      allow read: if isAdmin();
    }

    // ─────────────────────────────────────
    // plazaProfiles (광장 3D 공간 회원 프로필) 컬렉션
    // 캐릭터·지역·출생연도·직업·한줄소개 등 광장 표시용 정보.
    // 쓰기는 서버(Admin SDK)만: 닉네임 중복 검사·검증을 거친다 (/api/plaza/join).
    // 읽기도 본인·관리자만 (다른 회원 정보는 실시간 서버가 접속자끼리만 중계).
    // ─────────────────────────────────────
    match /plazaProfiles/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;
    }

    // plazaBlocks (광장 차단 목록): 본인·관리자만 읽기, 쓰기는 서버만
    match /plazaBlocks/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;
    }

    // plazaReports (광장 신고): 관리자만 읽기, 접수는 서버 API(/api/plaza/report)로만
    match /plazaReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────
    // plazaChats (광장 1:1 영속 대화) 컬렉션
    // convId = 두 회원 uid 정렬 결합. 저장은 서버(Admin SDK)만.
    // 읽기는 대화 당사자 또는 관리자(음란·범죄 예방 모더레이션)만. 실제 조회는 서버 API로.
    // ─────────────────────────────────────
    match /plazaChats/{convId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow write: if false;
      match /messages/{msgId} {
        allow read: if isAdmin() ||
          (isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/plazaChats/$(convId)).data.participants);
        allow write: if false;
      }
    }

  }
}
